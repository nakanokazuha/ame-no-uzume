          "enum": [
            "starting",
            "connected",
            "degraded",
            "disconnected"
          ],
          "title": "Connection",
          "type": "string"
        },
        "telemetry_mode": {
          "default": "standard",
          "enum": [
            "standard",
            "enhanced"
          ],
          "title": "Telemetry Mode",
          "type": "string"
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "agents": {
          "items": {
            "$ref": "#/$defs/AgentView"
          },
          "title": "Agents",
          "type": "array"
        },
        "conversation": {
          "items": {
            "$ref": "#/$defs/ConversationMessage"
          },
          "title": "Conversation",
          "type": "array"
        }
      },
      "required": [
        "sequence",
        "connection",
        "agents"
      ],
      "title": "WorldSnapshot",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "agent.removed": "#/$defs/AgentRemovedEvent",
      "agent.spawned": "#/$defs/AgentSpawnedEvent",
      "agent.state_changed": "#/$defs/AgentStateChangedEvent",
      "agent.task_changed": "#/$defs/AgentTaskChangedEvent",
      "approval.requested": "#/$defs/ApprovalRequestedEvent",
      "approval.resolved": "#/$defs/ApprovalResolvedEvent",
      "connection.changed": "#/$defs/ConnectionChangedEvent",
      "conversation.completed": "#/$defs/ConversationCompletedEvent",
      "conversation.delta": "#/$defs/ConversationDeltaEvent",
      "conversation.user_added": "#/$defs/ConversationUserAddedEvent",
      "run.finished": "#/$defs/RunFinishedEvent",
      "snapshot.replaced": "#/$defs/SnapshotReplacedEvent"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/AgentSpawnedEvent"
    },
    {
      "$ref": "#/$defs/AgentStateChangedEvent"
    },
    {
      "$ref": "#/$defs/AgentTaskChangedEvent"
    },
    {
      "$ref": "#/$defs/AgentRemovedEvent"
    },
    {
      "$ref": "#/$defs/ConnectionChangedEvent"
    },
    {
      "$ref": "#/$defs/SnapshotReplacedEvent"
    },
    {
      "$ref": "#/$defs/ConversationUserAddedEvent"
    },
    {
      "$ref": "#/$defs/ConversationDeltaEvent"
    },
    {
      "$ref": "#/$defs/ConversationCompletedEvent"
    },
    {
      "$ref": "#/$defs/ApprovalRequestedEvent"
    },
    {
      "$ref": "#/$defs/ApprovalResolvedEvent"
    },
    {
      "$ref": "#/$defs/RunFinishedEvent"
    }
  ]
}
